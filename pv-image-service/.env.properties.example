# ============================================================
# EXAMPLE / TEMPLATE — safe to commit.
# Copy this file to ".env.properties" and fill in real values.
#   cp .env.properties.example .env.properties   (bash)
#   Copy-Item .env.properties.example .env.properties   (PowerShell)
# The real ".env.properties" is git-ignored (see .gitignore).
# ============================================================

# --- Google Cloud Storage ---
# Globally-unique bucket name. Satisfies ${GCS_BUCKET} in application.properties.
GCS_BUCKET=changeme-your-bucket-name

# --- Database overrides (optional; defaults live in application.properties) ---
# DB_URL=jdbc:mysql://localhost:3306/images
# DB_USER=images
# DB_PASSWORD=imagespass

# ============================================================
# NOTE: Google credentials are NOT set here.
# GOOGLE_APPLICATION_CREDENTIALS is read from the OS environment,
# not from this file. Use one of:
#   gcloud auth application-default login
#   $env:GOOGLE_APPLICATION_CREDENTIALS = "D:\secrets\gcs-key.json"
# ============================================================
